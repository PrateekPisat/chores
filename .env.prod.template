# Production Environment Variables for Single Server Deployment
# Copy this file to .env.prod and update the values

# Application Environment
ENVIRONMENT=production
NODE_ENV=production
UI_TARGET=production

# Database Configuration
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Security
SECRET_KEY=your_very_long_secret_key_here_minimum_32_chars

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your_auth0_client_id
AUTH0_AUDIENCE=your_auth0_audience

# Frontend Configuration (API will be served via Nginx reverse proxy)
VITE_API_BASE_URL=http://your-domain.com/api
# For local deployment, use: http://localhost/api
VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=your_auth0_audience